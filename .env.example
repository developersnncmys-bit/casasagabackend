# Copy to .env and fill in
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/casasaga

# Auth — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Who may call the API (comma separated): the website and the admin panel
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Public address of this API, used to build links to uploaded images.
# Leave empty to use the address each request came in on.
PUBLIC_URL=

# The admin account the seed creates. Leave the password blank and the seed
# generates one and prints it once.
SEED_ADMIN_EMAIL=admin@casasaga.com
SEED_ADMIN_PASSWORD=

# Where the website's content lives, for the first import (npm run seed)
WEBSITE_DIR=../../casasagawebsite

# The public website — refreshed instantly when content changes.
# Use the same secret as REVALIDATE_SECRET in the website's .env.local
WEBSITE_URL=http://localhost:3000
REVALIDATE_SECRET=change-this-too

# Razorpay — online payment on the website's booking form.
# Dashboard → Account & Settings → API Keys (use Test Mode keys first: rzp_test_...).
# Leave empty and website bookings are confirmed without payment, as before.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Account & Settings → Webhooks: URL https://<backend>/api/public/razorpay/webhook,
# events payment.captured and order.paid, and the secret you set there
RAZORPAY_WEBHOOK_SECRET=
